{
  "hosting": {
    "public": "apps/mobile/build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "/@(index.html|main.dart.js|flutter_bootstrap.js|flutter.js|flutter_service_worker.js|version.json|manifest.json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      { "source": "/canvaskit/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ]
  }
}
