   ],
   "reasons": [
    {
     "widget_index": 0,
     "text": "இன்று எவ்வளவு செலவழிக்கலாம் என்பது எப்போதும் முதலில்."
    },
    {
     "widget_index": 1,
     "text": "உணவு டெலிவரி பாக்கெட் வேகமாக நிரம்புகிறது, அதனால் பாக்கெட்டுகள் அடுத்து."
    },
    {
     "widget_index": 2,
     "text": "நான் கவனித்த முக்கியமான விஷயம் இங்கே."
    },
    {
     "widget_index": 3,
     "text": "லேப்டாப் இலக்கு உங்களுக்கு முக்கியம் என்று சொன்னீர்கள்."
    },
    {
     "widget_index": 4,
     "text": "பாண்டி ட்ரிப் பணம் எவ்வளவு சேர்ந்திருக்கிறது என்று பார்க்க."
    },
    {
     "widget_index": 5,
     "text": "பணம் எங்கே போகிறது என்று ஒரே பார்வையில்."
    }
   ],
   "summary": "உங்கள் செலவு, லேப்டாப் இலக்கு, பாண்டி ட்ரிப் ஆகியவற்றைச் சுற்றி முகப்பை அமைத்தேன்."
  }
 },
