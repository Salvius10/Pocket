# Copy to .env and fill in. .env is git-ignored.
ENV=local
# dev = trust the X-Dev-User header (local only). firebase = verify Firebase ID tokens.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
# Postgres 16+. Leave empty to use a local SQLite file at .local/pocket.db
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/pocket
TEST_DATABASE_URL=
# Shared secret the agent sends to core-api internal endpoints
INTERNAL_TOKEN=change-me
CORE_API_URL=http://localhost:8080
AGENT_URL=http://localhost:8081
# Freeze "today" for demos (YYYY-MM-DD, IST). Empty = real today.
POCKET_TODAY=

# Only the agent service reads these. fake = canned responses, live = Gemini.
GEMINI_MODE=fake
GEMINI_API_KEY=
MODEL_LIVE=gemini-3.8-live
MODEL_FLASH=gemini-3.8-flash
# Optional: used only while MODEL_FLASH is overloaded or timing out, and logged each time. Empty = none.
MODEL_FLASH_FALLBACK=
GOLD_PRICE_PER_GRAM_PAISE=
