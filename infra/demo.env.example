# Copy to infra/demo.env (git-ignored) and fill in. Nothing here is committed.

# --- Google Cloud ---
PROJECT_ID=
REGION=asia-south1
# Any long random string. The agent sends it to core-api's internal endpoints.
INTERNAL_TOKEN=

# --- Gemini (agent only). Leave empty to deploy in fake mode. ---
GEMINI_API_KEY=
# Optional: used only while MODEL_FLASH is overloaded or timing out, and logged each time. Empty = none.
MODEL_FLASH_FALLBACK=

# --- Database. Leave both empty to run on SQLite inside one Cloud Run instance (resets on restart). ---
# Cloud SQL example: postgresql+asyncpg://USER:PASSWORD@/pocket?host=/cloudsql/PROJECT:asia-south1:INSTANCE
DATABASE_URL=
CLOUD_SQL_INSTANCE=

# --- Firebase (Project settings > Your apps > Web app). These are public identifiers, not secrets. ---
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=

# Freeze "today" so the demo stays aligned with the dataset (which ends 2026-11-19). Empty = real today.
POCKET_TODAY=2026-11-20
