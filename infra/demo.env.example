# Copy to infra/demo.env (git-ignored) and fill in. Nothing here is committed.

# --- Google Cloud ---
# The billing account that pays for hosting (console > Billing > Account ID, like 0X0X0X-0X0X0X-0X0X0X).
BILLING_ACCOUNT=
# The budget alert e-mails at 25%, 50% and 90% of this many US dollars. It warns; it does not stop spending.
BUDGET_USD=5
# Leave empty: infra/setup.ps1 creates a new project and writes its ID here.
PROJECT_ID=
REGION=asia-south1
# Any long random string. The agent sends it to core-api's internal endpoints.
INTERNAL_TOKEN=

# --- Gemini (agent only). Leave empty to deploy in fake mode. ---
GEMINI_API_KEY=
# Optional: used only while MODEL_FLASH is overloaded or timing out, and logged each time. Empty = none.
MODEL_FLASH_FALLBACK=

# --- Database. Leave both empty to run on SQLite inside the Cloud Run instance (gone when it sleeps). ---
# Cloud SQL example: postgresql+asyncpg://USER:PASSWORD@/pocket?host=/cloudsql/PROJECT:asia-south1:INSTANCE
DATABASE_URL=
CLOUD_SQL_INSTANCE=

# --- Sign-in and web hosting. infra/setup.ps1 fills these in. They are public identifiers, not secrets. ---
# firebase = Firebase Hosting; cloudrun = a small page server on Cloud Run (what setup.ps1 -NoFirebase sets).
WEB_HOST=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=

# Freeze "today" so the demo stays aligned with the dataset (which ends 2026-11-19). Empty = real today.
POCKET_TODAY=2026-11-20
